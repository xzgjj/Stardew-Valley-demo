; Engine configuration file.
; Stardew Valley 1:1 mechanics MVP — Godot 4.7.2 / GDScript.
; Locked version: see GODOT_VERSION.txt (4.7.2.stable.official.ed1daf0bf).

config_version=5

[application]

config/name="星露谷农场 MVP"
config/description="Stardew Valley 1:1 mechanics replica — first farm scene, core MVP systems."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

